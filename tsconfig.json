{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "lib": ["ES2021", "DOM"],
    "moduleResolution": "bundler",
    "rootDir": "guest-js",
    "declaration": true,
    "declarationDir": "./dist-js",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["guest-js/**/*.ts"]
}
